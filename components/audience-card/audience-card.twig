<article class="sdc-canvas-component audience-card">
  {% if image_url %}
    <div class="audience-card__image" style="background-image: url('{{ image_url }}')"></div>
  {% endif %}
  {% if icon_url %}
    <div class="audience-card__icon"><img src="{{ icon_url }}" alt=""></div>
  {% endif %}
  <div class="audience-card__body">
    <h2 class="audience-card__title">{{ title }}</h2>
    {% if description %}<p class="audience-card__description">{{ description }}</p>{% endif %}
    {% if link_label %}
      <a class="audience-card__link" href="{{ link_url|default('#') }}">{{ link_label }}</a>
    {% endif %}
  </div>
</article>
