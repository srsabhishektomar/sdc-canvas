<article class="sdc-canvas-component audience-card">
  {% set image_src = image_url.src|default(image_url) %}
  {% if image_src %}
    <div class="audience-card__image" style="background-image: url('{{ image_src }}')"></div>
  {% endif %}
  {% set icon_src = icon_url.src|default(icon_url) %}
  {% if icon_src %}
    <div class="audience-card__icon"><img src="{{ icon_src }}" alt=""></div>
  {% endif %}
  <div class="audience-card__body">
    <h2 class="audience-card__title">{{ title }}</h2>
    {% if description %}<p class="audience-card__description">{{ description }}</p>{% endif %}
    {% if link_label %}
      <a class="audience-card__link" href="{{ link_url|default('#') }}">{{ link_label }}</a>
    {% endif %}
  </div>
</article>
